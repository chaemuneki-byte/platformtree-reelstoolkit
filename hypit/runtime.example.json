{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "local": { "use": "@hypit/credential-store-local" }
  },
  "endpoints": {
    "media.local": { "use": "@hypit/media-local" },
    "html.local": { "use": "@hypit/provider-html-local" },
    "image.opencv.local": { "use": "@hypit/provider-image-opencv-local" },
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "config": {
        "expectedModel": "large-v3",
        "expectedDevice": "cpu",
        "expectedCompute": "int8",
        "expectedBatchSize": 4,
        "alignmentLanguages": ["ko", "en"]
      }
    }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "whisperx.local"
  }
}
